# Copy this file to .env and replace every placeholder with your own values.
# Never commit .env or put real credentials in this file.

DATABRICKS_HOST=https://<your-workspace-host>
DATABRICKS_TOKEN=<your-rotated-token>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<your-warehouse-id>

# Required by the local Airflow Compose setup.
FERNET_KEY=<generate-a-fernet-key>
AIRFLOW__API_AUTH__JWT_SECRET=<generate-a-long-random-secret>
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8080
